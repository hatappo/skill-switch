{
  "name": "skwitch",
  "version": "0.1.0",
  "description": "TUI for switching AI agent skills across agents.",
  "keywords": [
    "agent-skills",
    "ai",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "github-copilot",
    "opencode",
    "tui"
  ],
  "homepage": "https://github.com/hatappo/skill-switch#readme",
  "bugs": {
    "url": "https://github.com/hatappo/skill-switch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatappo/skill-switch.git"
  },
  "bin": {
    "skwitch": "./src/cli.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "README_ja.md"
  ],
  "type": "module",
  "scripts": {
    "start": "node src/cli.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "syntax": "node --check src/cli.ts && node --check src/core.ts && node --check src/tui.ts && node --check tests/core.test.ts",
    "test": "node --test tests/*.test.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm syntax && pnpm test",
    "fix": "pnpm format && pnpm lint:fix && pnpm typecheck && pnpm syntax && pnpm test",
    "prepublishOnly": "pnpm verify"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260526.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.3.0"
}
